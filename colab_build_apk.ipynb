# Maya Pro Native Flutter APK Builder - Google Colab Notebook
# ============================================================
# This notebook builds the native Flutter APK (15MB+) on Google Colab's x86_64 environment
# Auto-uploads to transfer.sh and provides direct download link
#
# Usage:
# 1. Open in Google Colab: https://colab.research.google.com/
# 2. Copy-paste this entire script into a new notebook
# 3. Run all cells sequentially
# 4. Get direct HTTPS download link at the end

# ============================================================
# CELL 1: Environment Setup & Dependencies
# ============================================================

!echo "🔧 Setting up environment..."

# Install system dependencies
!apt-get update -qq && apt-get install -y -qq \
    openjdk-17-jdk-headless \
    git \
    curl \
    unzip \
    libglu1-mesa \
    libgtk-3-0 \
    libblkid1 \
    libxxf86vm1 \
    2>/dev/null | tail -5

# Set Java 17 as default
!update-alternatives --set java /usr/lib/jvm/java-17-openjdk-amd64/bin/java
!export JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

# Verify Java
!java -version

# ============================================================
# CELL 2: Install Flutter SDK
# ============================================================

!echo "📦 Installing Flutter SDK..."

# Download Flutter SDK (latest stable)
!cd /opt && \
    git clone https://github.com/flutter/flutter.git -b stable --depth 1 2>/dev/null && \
    echo "Flutter cloned successfully"

# Add Flutter to PATH
import os
os.environ["PATH"] = "/opt/flutter/bin:" + os.environ["PATH"]

# Verify Flutter
!flutter --version

# ============================================================
# CELL 3: Configure Android SDK
# ============================================================

!echo "🤖 Configuring Android SDK..."

# Set Android SDK environment
import os
os.environ["ANDROID_HOME"] = "/opt/android-sdk"
os.environ["ANDROID_SDK_ROOT"] = "/opt/android-sdk"
os.environ["PATH"] = "/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:" + os.environ["PATH"]

# Install Android SDK command line tools if not present
!mkdir -p /opt/android-sdk/cmdline-tools
!cd /opt/android-sdk && \
    wget -q https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip -O cmdline-tools.zip && \
    unzip -q cmdline-tools.zip -d cmdline-tools && \
    mv cmdline-tools/cmdline-tools cmdline-tools/latest && \
    rm cmdline-tools.zip

# Accept licenses and install required components
!yes | /opt/android-sdk/cmdline-tools/latest/bin/sdkmanager --licenses >/dev/null 2>&1
!/opt/android-sdk/cmdline-tools/latest/bin/sdkmanager \
    "platforms;android-34" \
    "build-tools;35.0.0" \
    "platform-tools" \
    "ndk;26.1.10909125" \
    2>/dev/null | tail -10

# Verify
!echo "ANDROID_HOME=$ANDROID_HOME"
!ls /opt/android-sdk/platforms/
!ls /opt/android-sdk/build-tools/

# ============================================================
# CELL 4: Clone Repository
# ============================================================

!echo "📥 Cloning repository..."

!cd /content && \
    rm -rf M-2.0 && \
    git clone https://github.com/supportinboxmaya-a11y/M-2.0.git 2>/dev/null && \
    echo "Repository cloned successfully"

# Navigate to Flutter project
!cd /content/M-2.0/maya_flutter && pwd

# ============================================================
# CELL 5: Build Release APK
# ============================================================

!echo "🏗️ Building Release APK..."

import os
os.chdir("/content/M-2.0/maya_flutter")

# Clean previous builds
!flutter clean

# Get dependencies
!flutter pub get

# Build release APK
!flutter build apk --release --no-tree-shake-icons 2>&1 | tail -30

# ============================================================
# CELL 6: Verify APK Output
# ============================================================

!echo "✅ Verifying APK..."

import os
apk_path = "/content/M-2.0/maya_flutter/build/app/outputs/flutter-apk/app-release.apk"

if os.path.exists(apk_path):
    size_mb = os.path.getsize(apk_path) / (1024 * 1024)
    print(f"✅ APK found: {apk_path}")
    print(f"📦 Size: {size_mb:.2f} MB")
    
    # Verify APK signature
    import subprocess
    result = subprocess.run(
        ["/opt/android-sdk/build-tools/35.0.0/apksigner", "verify", "--print-certs", "/content/M-2.0/maya_flutter/build/app/outputs/flutter-apk/app-release.apk"],
        capture_output=True, text=True
    )
    print("✅ Signature verification:")
    print(result.stdout)
else:
    print("❌ APK not found!")
    # List build outputs
    import subprocess
    subprocess.run(["find", "/content/M-2.0/maya_flutter/build", "-name", "*.apk", "-o", "-name", "*.aab"], capture_output=True, text=True)

# ============================================================
# CELL 7: Auto-upload to transfer.sh & Generate Download Link
# ============================================================

!echo "🚀 Uploading APK to transfer.sh..."

import os
import subprocess
import requests

apk_src = "/content/M-2.0/maya_flutter/build/app/outputs/flutter-apk/app-release.apk"
apk_dst = "/content/maya_pro_release.apk"

if os.path.exists("/content/M-2.0/maya_flutter/build/app/outputs/flutter-apk/app-release.apk"):
    
    # Copy to working directory
    import shutil
    shutil.copy2(
        "/content/M-2.0/maya_flutter/build/app/outputs/flutter-apk/app-release.apk",
        "/content/maya_pro_release.apk"
    )
    
    size_mb = os.path.getsize("/content/maya_pro_release.apk") / (1024 * 1024)
    print(f"✅ APK ready: {size_mb:.2f} MB")
    
    # Upload to transfer.sh
    print("📤 Uploading to transfer.sh...")
    
    try:
        # Use curl via subprocess for reliable upload
        result = subprocess.run([
            "curl", 
            "--upload-file", "/content/maya_pro_release.apk",
            "https://transfer.sh/maya_pro_release.apk",
            "-H", "Max-Days: 14",
            "-H", "Max-Downloads: 100",
            "--progress-bar",
            "-s"
        ], capture_output=True, text=True, timeout=120)
        
        if result.returncode == 0 and result.stdout.strip():
            download_url = result.stdout.strip()
            print(f"\n{'='*60}")
            print(f"🎉 UPLOAD SUCCESSFUL!")
            print(f"{'='*60}")
            print(f"📥 DIRECT DOWNLOAD LINK:")
            print(f"   {download_url}")
            print(f"{'='*60}")
            print(f"📦 File: maya_pro_release.apk ({os.path.getsize('/content/maya_pro_release.apk') / (1024*1024):.2f} MB)")
            print(f"⏱️  Expires: 14 days / 100 downloads")
            print(f"{'='*60}")
            
            # Also try file.io as backup
            print("\n📤 Uploading backup to file.io...")
            try:
                with open("/content/maya_pro_release.apk", "rb") as f:
                    backup_result = requests.post(
                        "https://file.io",
                        files={"file": ("maya_pro_release.apk", open("/content/maya_pro_release.apk", "rb"))},
                        timeout=120
                    )
                    if backup_result.status_code == 200:
                        backup_data = backup_result.json()
                        if backup_data.get("success"):
                            print(f"📥 Backup mirror: {backup_data.get('link')}")
            except Exception as e:
                print(f"⚠️ file.io backup failed: {e}")
                
        except Exception as e:
            print(f"⚠️ transfer.sh upload failed: {e}")
            print("Trying file.io as fallback...")
            try:
                with open("/content/maya_pro_release.apk", "rb") as f:
                    backup_result = requests.post(
                        "https://file.io",
                        files={"file": ("maya_pro_release.apk", open("/content/maya_pro_release.apk", "rb"))},
                        timeout=120
                    )
                    if backup_result.status_code == 200:
                        backup_data = backup_result.json()
                        if backup_data.get("success"):
                            print(f"📥 Backup mirror: {backup_data.get('link')}")
            except Exception as e:
                print(f"❌ All uploads failed: {e}")
    else:
        print("❌ APK not found at expected location")
        # Search for any APK
        import subprocess
        result = subprocess.run(["find", "/content", "-name", "*.apk"], capture_output=True, text=True)
        print("APK search results:")
        print(result.stdout)

