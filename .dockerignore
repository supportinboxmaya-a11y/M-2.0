# Maya 2.0 ULTRA - Docker Ignore
# Files and directories to exclude from Docker build context

# Version control
.git
.gitignore

# Python
__pycache__
*.pyc
*.pyo
*.pyd
.Python
venv/
env/
*.egg-info/
dist/
build/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/

# Frontend build
frontend/dist/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Storage (runtime data)
storage/
*.sqlite3
*.db

# Backups
backups/

# Environment
.env
.env.local
.env.*.local

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# Documentation
*.md
!README.md

# Tests
test_*.py
*_test.py
pytest.ini
.coverage
htmlcov/

# CI/CD
.github/
.gitlab-ci.yml

# Temporary
tmp/
temp/
*.tmp

# Large files
*.tar.gz
*.zip
*.whl