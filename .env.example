# Maya — env vars (GROQ_KEY or GROQ_API_KEY, both work)
GROQ_KEY=your_groq_key
NVIDIA_NIM_KEY=your_nvidia_nim_key
GEMINI_KEY=your_gemini_key
OPENAI_KEY=your_openai_key
ANTHROPIC_KEY=your_anthropic_key
DEEPSEEK_KEY=your_deepseek_key
GOOGLE_API_KEY=your_google_key
GOOGLE_CSE_ID=your_cse_id
SECRET_KEY=change-this
ADMIN_EMAIL=admin@maya.ai
ADMIN_PASSWORD=change-this-password
CORS_ORIGINS=*

# ── APIKeyProvisioner ─────────────────────────────
PROVISIONER_EMAIL=your_email@example.com
PROVISIONER_NAME=Your Name
BUDGET_USD=1.0
APP_MONITOR_ENABLED=false
COGNITION_ENABLED=false
COGNITION_AUTORUN=false
# Route maya.run() through the cognitive kernel's unified loop
# (single control entry: persistent goal -> grounding -> execute -> learn)
MAYA_UNIFIED_LOOP=false
# Phase 42 self-improvement loop (propose-only; tool loading still needs
# ToolCreator AST scan + human approval)
SELF_IMPROVE_ENABLED=false
# Phase 41: re-execute previously-ACTIVE goals after restart
# (SUSPENDED/BLOCKED goals always stay propose-only)
MAYA_AUTO_RESUME=false
DEPLOY_PIPELINE_ENABLED=false
RESEARCH_ENGINE_ENABLED=false
PORT=8000
DEV=false

# ── Oracle VPS Backend (production) ────────────────
# VPS IP: 130.210.46.182 (port 8000)
# SSH: root@130.210.46.182 -p 20045
# Frontend/API Gateway rewrites point to http://130.210.46.182:8000

# ── Email (SMTP) — for email_tool and notifications ─
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com

# ── Webhook URLs — for webhook_send tool ────────
# Get these from your Slack/Discord channel settings → Integrations → Webhooks
# WEBHOOK_SLACK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# WEBHOOK_DISCORD_URL=https://discord.com/api/webhooks/xxx/yyy
# WEBHOOK_GENERIC_URL=https://your-endpoint.example.com/hook

# ── Push notifications (FCM) — for phone alerts ──
# Path to Firebase Admin SDK credentials JSON file (downloaded from Firebase Console)
# FCM_CREDENTIALS_PATH=/path/to/firebase-credentials.json

# ── M1 Key Management (optional) ───────────────
# When M1_INTEGRATION_ENABLED=true, settings.py asks M1's keystore
# for API keys, falling back to the *_KEY vars above.
M1_INTEGRATION_ENABLED=false
M1_URL=http://localhost:3001
M1_KEYS_TOKEN=

# ── Supabase (multi-user) ──────────────────────
# From your Supabase project: Settings > API
# SUPABASE_SERVICE_KEY is the "service_role" secret key — server-side ONLY,
# never expose it to the frontend or commit it to git.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key
DEFAULT_USER_BUDGET_USD=5.0

# ── Phase 38: MCP servers (Maya as MCP host) ───
# Master switch — ships OFF.
MCP_ENABLED=false
# JSON list of MCP server configs:
#   command = stdio server, url = Streamable HTTP server
#   tools_allow / tools_deny = optional per-server tool filters
# MCP_SERVERS=[{"name":"filesystem","command":["npx","-y","@modelcontextprotocol/server-filesystem","/tmp"],"tools_deny":["remove_file"]}]

# OpenRouter fallback (free tier) — survives NIM throttle windows
# OPENROUTER_KEY=sk-or-v1-...
# Default: nvidia/nemotron-3-super-120b-a12b:free (verify :free slugs — they rotate)
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
