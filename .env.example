# Maya — env vars (GROQ_KEY or GROQ_API_KEY, both work)
GROQ_KEY=your_groq_key
NVIDIA_NIM_KEY=your_nvidia_nim_key
GEMINI_KEY=your_gemini_key
OPENAI_KEY=your_openai_key
ANTHROPIC_KEY=your_anthropic_key
DEEPSEEK_KEY=your_deepseek_key
GOOGLE_API_KEY=your_google_key
GOOGLE_CSE_ID=your_cse_id
SECRET_KEY=change-this
ADMIN_EMAIL=admin@maya.ai
ADMIN_PASSWORD=change-this-password
CORS_ORIGINS=*
BUDGET_USD=1.0
APP_MONITOR_ENABLED=false
COGNITION_ENABLED=false
COGNITION_AUTORUN=false
DEPLOY_PIPELINE_ENABLED=false
RESEARCH_ENGINE_ENABLED=false
PORT=8000
DEV=false

# ── M1 Key Management (optional) ───────────────
# When M1_INTEGRATION_ENABLED=true, settings.py asks M1's keystore
# for API keys, falling back to the *_KEY vars above.
M1_INTEGRATION_ENABLED=false
M1_URL=http://localhost:3001
M1_KEYS_TOKEN=

# ── Supabase (multi-user) ──────────────────────
# From your Supabase project: Settings > API
# SUPABASE_SERVICE_KEY is the "service_role" secret key — server-side ONLY,
# never expose it to the frontend or commit it to git.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key
DEFAULT_USER_BUDGET_USD=5.0
